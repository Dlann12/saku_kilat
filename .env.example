APP_NAME=SakuKilat
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

BCRYPT_ROUNDS=12

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=54330
DB_DATABASE=sakukilat
DB_USERNAME=sakukilat
DB_PASSWORD=sakukilat_dev_password

SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=database

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6381

SAKUKILAT_WEBHOOK_HMAC_SECRET="replace-with-hmac-secret"
SAKUKILAT_SANDBOX_OTP=true

VITE_APP_NAME="${APP_NAME}"
